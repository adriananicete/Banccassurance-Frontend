# Copy to .env. Every value here is safe to commit; .env itself is ignored so
# that a future secret cannot be added to it by accident and pushed.

# The backend's own base path. Every route lives under /api/v1 -- there is no
# bare /api, it answers 404.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# The API origin, without the /api/v1 prefix. Two things need it:
#   - avatar images, served from GET /uploads/<filename>
#   - the socket.io connection (Phase 3)
VITE_API_ORIGIN=http://localhost:5000
